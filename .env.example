# Copy to .env, restrict it to your user (chmod 600 .env), then fill in locally.
# Keys are read from macOS Keychain first (services: openrouter-api, typesafe-api), then from this file.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Optional settings
# COMPUTAH_DECISION=openrouter            # or jev; default: jev when a TypeSafe key exists
# COMPUTAH_DECISION_MODEL=anthropic/claude-haiku-5.5
# COMPUTAH_JEV_MODEL=jev-1.13.0
# COMPUTAH_SPEECH_LANGUAGE=pt
